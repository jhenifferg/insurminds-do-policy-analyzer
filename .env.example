# Configuração local opcional. Carregue com:
#   set -a; source .env; set +a
# Nunca coloque credenciais reais neste arquivo ou no Git.

# Gemini é o provider primário da aplicação.
LLM_PROVIDER=Gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# Chave/modelo específicos do Gemini. Têm prioridade para esse provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Fallback automático quando Gemini falhar.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Compatibilidade com seleção manual de OpenAI na interface.
OPENAI_API_KEY=
OPENAI_MODEL=

DATABASE_PATH=data/insurminds.sqlite3
